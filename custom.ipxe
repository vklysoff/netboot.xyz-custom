#!ipxe

:custom
clear custom_choice
menu Its me Mario
item --gap Automatron:
item auto ${space} Seek & Destroy ||
choose custom_choice || goto custom_exit
echo ${cls}
goto ${custom_choice}
goto custom_exit

#:auto
#chain https://raw.githubusercontent.com/${github_user}/netboot.xyz-custom/master/my_auto.ipxe || goto error
#goto main_menu
#
#:custom_exit
#chain utils.ipxe
#exit
