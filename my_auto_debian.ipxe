#!ipxe

set preseed_url http://${dhcp-server}:8480/ps/preseed.cfg

isset ${dhcp-server} && set ipparam ip=dhcp || set ipparam ip=${ip}::${gateway}:${netmask}:::none nameserver=${dns}
set ipparam BOOTIF=${netX/mac} ${ipparam}


goto ${menu} ||

:menu_auto_debian
iseq ${os_arch} x86_64 && set os_arch amd64 ||
iseq ${os_arch} i386 && set os_arch i386 ||
iseq ${os_arch} arm64 && set os_arch arm64 ||
menu Oracle Family
item --gap Target
item bookworm ${space} Debian GNU/Linux 12 (bookworm)
item --gap Setup
item preseed ${space} Preseed URL: [${preseed_url}]
choose menu || goto auto_exit
goto ${menu}

:preseed
echo -n Please enter your custom preseed URL here: ${} && read preseed_url
set install_params auto=true priority=critical preseed/url=${preseed_url}
goto menu_auto_debian

:bookworm
set os_arch amd64
set debian_version ${menu}
set dir ${debian_base_dir}/dists/${debian_version}/main/installer-amd64/current/images/netboot/
set dir ${dir}${menu}-installer/amd64
goto deb_boot

:deb_boot
imgfree
kernel ${debian_mirror}/${dir}/linux ${install_params} ${netcfg} ${mirrorcfg} initrd=initrd.magic ${cmdline}
initrd ${debian_mirror}/${dir}/initrd.gz
echo
echo MD5sums:
md5sum linux initrd.gz
boot



:auto_exit
clear menu
exit 0
